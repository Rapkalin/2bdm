{
    "name": "rapkalin/2bdm",
    "description": "The o2bdm architecture studio's official website",
    "type": "project",
    "version": "1.0.1",
    "autoload": {
        "psr-4": {
            "App\\": "website/app/"
        }
    },
    "authors": [
        {
            "name": "Rapkalin",
            "email": "raphael@rapkalin.fr"
        }
    ],
    "repositories":[
        {
            "type":"composer",
            "url":"https://wpackagist.org"
        }
    ],
    "require": {
        "php": ">=8.2",
        "johnpbloch/wordpress": "^6.3",
        "composer/installers": "^1.12",
        "vlucas/phpdotenv": "^5.5",

        "wpackagist-plugin/webp-converter-for-media":"^6.2",
        "phpmailer/phpmailer": "^6.10",
        "wpackagist-plugin/weglot": "5.1"
    },

    "require-dev": {
        "symfony/var-dumper": "^5.4"
    },

    "config": {
        "vendor-dir": "website/vendor",
        "allow-plugins": {
            "composer/installers": true,
            "johnpbloch/wordpress-core-installer": true
        }
    },
    "extra": {
        "wordpress-install-dir": "website/wordpress-core",
        "installer-paths": {
            "website/app/themes/{$name}/": [
                "type:wordpress-theme"
            ],
            "website/app/plugins/{$name}/": [
                "type:wordpress-plugin"
            ]
        }
    }
}
